# ============================================================
# MediaDubFlow — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Translation ---
TRANSLATION_PROVIDER=openai        # openai | anthropic
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Speech-to-Text ---
STT_BACKEND=faster_whisper
WHISPER_MODEL_SIZE=large-v3        # tiny | base | small | medium | large-v3

# --- Speaker Diarization ---
# Required to download pyannote.audio model weights from HuggingFace.
# Accept the model license at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_...

# --- Text-to-Speech ---
TTS_BACKEND=coqui                  # coqui | openai
TTS_MODEL=tts_models/km/fairseq/vits

# --- Processing ---
MAX_CONCURRENT_EPISODES=2          # 1–8
USE_GPU=true
DEVICE=auto                        # auto | cpu | cuda | mps

# --- Paths ---
OUTPUT_ROOT=./output
CACHE_DIR=./.cache
LOG_DIR=./logs

# --- Logging ---
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false
